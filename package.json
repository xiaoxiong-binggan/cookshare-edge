{
  "name": "cookshare-edge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "基于阿里云ESA Pages的边缘计算美食应用 - 参赛作品",
  "author": "xiaoxiong-binggan",
  "license": "MIT",
  "keywords": [
    "esa-pages",
    "edge-computing",
    "react",
    "pwa",
    "ai",
    "阿里云"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:edge": "cd edge-functions && npm run build",
    "deploy": "npm run build && aliyun esa deploy",
    "test": "vitest",
    "format": "prettier --write .",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.2",
    "zustand": "^4.4.1",
    "axios": "^1.4.0",
    "antd": "^5.8.1",
    "@ant-design/icons": "^5.2.6",
    "ahooks": "^3.7.8",
    "dayjs": "^1.11.9",
    "classnames": "^2.3.2",
    "swr": "^2.2.0",
    "socket.io-client": "^4.6.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/node": "^20.4.2",
    "@vitejs/plugin-react": "^4.0.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vite-plugin-pwa": "^0.16.4",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "prettier": "^3.0.0",
    "vitest": "^0.34.1"
  }
}
